<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Drives the generator over in-memory snippets in the harness (arbitrary arities/diagnostics). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the generator BOTH as a runnable analyzer (so this assembly gets the variadic
         types generated for the runtime tests, driven by [assembly: VariadicArity] below) AND as a
         normal assembly (so the driver harness can instantiate VariadicGenerator directly). -->
    <ProjectReference Include="..\..\src\NTypeForge.Variadic.SourceGenerator\NTypeForge.Variadic.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
